{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://spectrasynq.local/schemas/audio-reference-scoring-profile.v1.schema.json",
  "title": "Named host Audio Reference scoring profile",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "profile_id", "thresholds"],
  "properties": {
    "schema": {"const": "spectrasynq.audio-reference-scoring-profile.v1"},
    "profile_id": {"type": "string", "minLength": 1},
    "description": {"type": "string"},
    "threshold_authority": {"type": "string", "minLength": 1},
    "thresholds": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": false,
      "properties": {
        "max_abs_rate_error_ppm": {"type": "number", "minimum": 0},
        "max_timestamp_error_p99_us": {"type": "number", "minimum": 0},
        "max_missing_samples": {"type": "integer", "minimum": 0},
        "max_abs_lag_ms": {"type": "number", "minimum": 0},
        "max_abs_drift_ppm": {"type": "number", "minimum": 0},
        "min_signed_correlation": {"type": "number", "minimum": -1, "maximum": 1},
        "max_abs_gain_error_db": {"type": "number", "minimum": 0},
        "max_interchannel_gain_error_db": {"type": "number", "minimum": 0},
        "max_abs_dc_offset_error": {"type": "number", "minimum": 0},
        "max_residual_rms": {"type": "number", "minimum": 0},
        "max_clipped_samples_per_channel": {"type": "integer", "minimum": 0}
      }
    },
    "requirements": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "channel_identity_match": {"const": true},
        "positive_polarity": {"const": true},
        "exact_sample_count": {"const": true}
      }
    }
  }
}
