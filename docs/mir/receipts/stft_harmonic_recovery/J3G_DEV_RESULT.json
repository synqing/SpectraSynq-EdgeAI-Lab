  "selection": {
    "rule": {
      "why_a_rule_is_pre_registered": "exactly one winner must reach FINAL and Level C. Choosing it after seeing all scores would be selection on the outcome. The rule below is fixed now and is a SELECTION DEVICE ONLY - it is never reported as a headline result, and every component is reported separately.",
      "blocking_gate_1": "candidate ACOUSTIC_CHANGE_LOW_HARMONIC_CHANGE false-response rate must not exceed P0's by more than 0.02. No candidate may win by becoming more reactive to non-harmonic energy.",
      "score": "selection_score = 0.5 * mean(challenge recall on HARMONIC_CHANGE_FLAT_ENERGY and HARMONIC_CHANGE_NO_ONSET) + 0.5 * clip(worst-family solo R-squared, 0, 1)",
      "score_justification": "the two halves encode the two things J3F said matter: recover genuine harmonic events, and do not win by improving only the easy timbres.",
      "tie_break_order": [
        "lower non-root mass on the HARMONIC_NOTE fixture",
        "smaller family max-minus-min spread",
        "lower arithmetic cost per frame"
      ],
      "blocking_gate_2_WITHDRAWN": {
        "withdrawn_text": "candidate non-root mass on the HARMONIC_NOTE fixture must be <= host_chroma12's 0.151, AND the candidate must not reduce MAJOR_TRIAD's three chord-tone mass below 0.70 of host_chroma12's value.",
        "status": "WITHDRAWN before any corpus score. Replaced by the reporting requirement the Captain actually specified."
      },
      "phantom_triad_reporting_requirement": "the fixture vector is REPORTED for every candidate and discussed. It is not an elimination gate. The one clause that IS blocking is the Captain's own anti-gaming clause: a candidate that collapses a genuine MAJOR_TRIAD towards a single pitch class - chord-tone mass below 0.70 of P0's on the same fixture - fails Level B regardless of its single-note behaviour."
    },
