  "analysis_block_decision": {
    "chosen_primary_block_size_samples": 2048,
    "step_size_samples": 512,
    "this_follows_the_brief": true,
    "why_2048_is_the_right_choice": [
      "2048 samples at 16 kHz is EXACTLY the existing host_chroma12 window (n_fft 2048, hop 512). The NNLS front end therefore sees the same time-frequency support as the SpectraSynq STFT it is being compared against, so the contrast with C3 is a single-variable change of PROJECTION METHOD and is not confounded by window length.",
      "2048 samples = 4 hops, which is strictly less than the movement lag of 8 hops. The two states compared by tv_movement therefore share NO window content, so the movement metric is not mechanically attenuated.",
      "measured: it is not materially worse than larger blocks (see the disclosed diagnostic below)."
    ],
    "PRIOR_ANALYST_RECOMMENDATION_WITHDRAWN": {
      "what_I_previously_proposed": "block 4096 as primary, on the argument that a 2048-sample block at 16 kHz cannot resolve three bins per semitone below roughly MIDI 68 (linear FFT bin spacing 7.81 Hz exceeds one third of a semitone below about 394 Hz), and that this would forfeit exactly the low-register resolution J3N proved valuable.",
      "why_it_is_withdrawn": "the argument makes a testable prediction - that block 2048 should transcribe the bass materially worse than block 4096 - and measurement does not support it. On real audio the two are effectively tied, including in the bass. The theoretical resolution loss is real but the plugin interpolates the log-frequency axis from the linear spectrum with a cosine kernel and the NNLS dictionary is tolerant of the resulting smear, so the note attribution survives.",
      "status": "my earlier reasoning was wrong and is corrected by measurement. The brief's block 2048 stands unamended."
    },
    "DISCLOSED_SELECTION_DIAGNOSTIC": {
      "what_was_measured": "mean per-frame cosine agreement between the plugin's 84-bin semitone spectrum folded to 12 pitch classes and the MIDI pitch-class mass target, on the first 30 s of 7 stems drawn from 5 tracks, with useNNLS=1 only",
      "when": "BEFORE this pre-registration was written and before any outcome metric was computed",
      "is_this_an_outcome_metric": false,
      "was_any_arm_contrast_seen": false,
      "why_it_is_disclosed": "the block size has to be fixed before scoring, and fixing it on evidence rather than assertion means the evidence was gathered first. The metric used is not one of the pre-registered outcome metrics and no FRONTEND_ONLY vs NNLS_NOTES comparison was computed.",
      "results_pitch_class_cosine": {
