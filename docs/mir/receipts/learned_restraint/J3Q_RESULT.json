    "standardisation": "mean and standard deviation fitted on TRAINING TRACKS ONLY within each fold"
  },
  "supervision": {
    "this_is_a_restraint_policy_target_not_a_chroma_regression_target": true,
    "source": "the existing rectangular MIDI harmonic-movement oracle, unmodified",
    "POSITIVE_KEEP": "oracle movement within-track rank >= 0.95 - genuine strongest harmonic-change events",
    "NEGATIVE_SUPPRESS": "oracle movement rank <= 0.50 AND C3 movement rank >= 0.80 - frames where C3 is actively moving while the symbolic harmonic state is stable",
    "AMBIGUOUS": "everything else - EXCLUDED from the classifier loss, never silently labelled negative",
    "what_this_makes_the_supervision_ask": "when C3 wants to move, is this a genuine harmonic event or an unwanted response?"
  },
  "onset_descriptor_deviation_DISCLOSED": {
    "what": "J3Q uses the onset descriptor with NO fitted alignment shift (shift 0)",
