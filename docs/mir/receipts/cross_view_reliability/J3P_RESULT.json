    "transition_confidence": "C(t) = min( A(t), A(t-8) )",
    "gated_movement": "M_GATED(t) = C3_movement(t) * C(t)",
    "range_argument": "both states are non-negative and L1-normalised, so 0.5*L1 lies in [0,1] and therefore A and C lie in [0,1]. No clipping is applied and none is needed.",
